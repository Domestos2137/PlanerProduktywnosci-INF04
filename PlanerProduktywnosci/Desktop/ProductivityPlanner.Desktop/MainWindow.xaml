<Window x:Class="ProductivityPlanner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Planer Produktywności" Height="500" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Twoje Zadania" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" Grid.Row="0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,20">
            <TextBox x:Name="txtNewTaskTitle" Width="200" Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="5" />

            <TextBox x:Name="txtDescription" Width="200" Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="5" />

            <ComboBox x:Name="cmbCategory" Width="100" Margin="0,0,10,0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Praca" IsSelected="True"/>
                <ComboBoxItem Content="Dom"/>
                <ComboBoxItem Content="Inne"/>
            </ComboBox>
            <Button Content="Dodaj zadanie" Click="btnAdd_Click" Padding="15,5" Background="#28A745" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <DataGrid x:Name="dgTasks" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="150"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="100"/>
                <DataGridCheckBoxColumn Header="Gotowe" Binding="{Binding IsCompleted}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Usuń wybrane zadanie" Click="btnDelete_Click" 
            HorizontalAlignment="Right" Margin="0,10,0,0" Padding="15,5" 
            Background="#DC3545" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>