<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlanerApp.AddTaskPage"
             Title="Nowe zadanie"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Spacing="15" Padding="20">
        <Label Text="Co masz do zrobienia?" FontSize="20" FontAttributes="Bold" TextColor="#2C3E50" />

        <Frame CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
            <Entry x:Name="TitleEntry" Placeholder="Tytuł zadania" Margin="10,0" HeightRequest="45" />
        </Frame>

        <Frame CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
            <Editor x:Name="DescriptionEditor" Placeholder="Opis (opcjonalnie)" HeightRequest="100" Margin="10,5" />
        </Frame>

        <Label Text="Kategoria:" VerticalOptions="Center" TextColor="#7F8C8D" />
        <Frame CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
            <Picker x:Name="CategoryPicker" Title="Wybierz kategorię" Margin="10,0">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>dom</x:String>
                        <x:String>praca</x:String>
                        <x:String>inne</x:String>
                    </x:Array>
                </Picker.ItemsSource>
                <Picker.SelectedIndex>2</Picker.SelectedIndex>
            </Picker>
        </Frame>

        <Label Text="Termin wykonania:" VerticalOptions="Center" TextColor="#7F8C8D" />
        <Frame CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
            <DatePicker x:Name="DueDatePicker" Margin="10,0" Format="dd.MM.yyyy" />
        </Frame>

        <Button Text="Dodaj zadanie" 
                Clicked="OnSaveClicked" 
                BackgroundColor="#2ECC71" 
                TextColor="White" 
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,10,0,0" />
    </VerticalStackLayout>
</ContentPage>