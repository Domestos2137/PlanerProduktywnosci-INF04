<Window x:Class="ProductivityPlanner.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie - Planer" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Zaloguj się" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Użytkownik:"/>
            <TextBox x:Name="txtUsername" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Hasło:"/>
            <PasswordBox x:Name="txtPassword" Margin="0,5,0,20" Padding="5"/>

            <Button Content="Zaloguj" Click="btnLogin_Click" Height="35" Background="#007ACC" Foreground="White"/>
            <TextBlock x:Name="lblStatus" Foreground="Red" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>