<Window x:Class="ProductivityPlanner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planer Produktywności - Panel Zarządzania" Height="650" Width="1100" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Twoje Centrum Zadań" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <TextBox x:Name="txtSearch" Width="200" Padding="5" TextChanged="txtSearch_TextChanged"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="5" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Dane zadania:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtNewTaskTitle" Width="150" Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="5" ToolTip="Tytuł zadania (wymagany)"/>
                    <TextBox x:Name="txtDescription" Width="180" Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="5" ToolTip="Opis"/>

                    <DatePicker x:Name="dpDueDate" Width="110" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                    <ComboBox x:Name="cmbStatus" Width="90" Margin="0,0,10,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Nowe" IsSelected="True"/>
                        <ComboBoxItem Content="W toku"/>
                        <ComboBoxItem Content="Gotowe"/>
                    </ComboBox>

                    <ComboBox x:Name="cmbPriority" Width="90" Margin="0,0,10,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Niski"/>
                        <ComboBoxItem Content="Normalny" IsSelected="True"/>
                        <ComboBoxItem Content="Wysoki"/>
                    </ComboBox>

                    <ComboBox x:Name="cmbCategory" Width="90" Margin="0,0,15,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Praca" IsSelected="True"/>
                        <ComboBoxItem Content="Dom"/>
                        <ComboBoxItem Content="Inne"/>
                    </ComboBox>

                    <Button Content="Dodaj +" Click="btnAdd_Click" Padding="15,5" Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,5,0"/>
                    <Button Content="Zapisz zmiany" Click="btnUpdate_Click" Padding="10,5" Background="#FFC107" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgTasks" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" 
                  SelectionMode="Single" Background="White" BorderBrush="#DEE2E6" AlternatingRowBackground="#F2F2F2"
                  FontSize="13" RowHeight="30" SelectionChanged="dgTasks_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="150"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="90"/>
                <DataGridTextColumn Header="Priorytet" Binding="{Binding Priority}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Termin" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="📊 Generuj Raport CSV" Click="btnExportCSV_Click" 
                    Margin="0,0,10,0" Padding="15,8" Background="#17A2B8" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="🗑 Usuń zaznaczone" Click="btnDelete_Click" 
                    Padding="15,8" Background="#DC3545" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>