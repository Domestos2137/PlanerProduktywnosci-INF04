<Grid Margin="10">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Twoje Zadania" FontSize="20" Margin="0,0,0,10" Grid.Row="0"/>

    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,15">
        <TextBox x:Name="txtNewTaskTitle" Width="250" Margin="0,0,10,0" Tag="Tytuł zadania..."/>
        <ComboBox x:Name="cmbCategory" Width="120" Margin="0,0,10,0">
            <ComboBoxItem Content="Praca" IsSelected="True"/>
            <ComboBoxItem Content="Dom"/>
            <ComboBoxItem Content="Inne"/>
        </ComboBox>
        <Button Content="Dodaj zadanie" Click="btnAdd_Click" Padding="10,5" Background="#28A745" Foreground="White"/>
    </StackPanel>

    <DataGrid x:Name="dgTasks" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="*"/>
            <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="150"/>
            <DataGridCheckBoxColumn Header="Gotowe" Binding="{Binding IsCompleted}" Width="80"/>
        </DataGrid.Columns>
    </DataGrid>
</Grid>